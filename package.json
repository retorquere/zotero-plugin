{
  "name": "zotero-plugin",
  "version": "11.0.12",
  "description": "Zotero plugin builder",
  "homepage": "https://github.com/retorquere/zotero-plugin/wiki",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./build": {
      "import": "./dist/esm/build.js",
      "require": "./dist/cjs/build.cjs"
    },
    "./debug-log": {
      "import": "./dist/esm/debug-log.js",
      "require": "./dist/cjs/debug-log.cjs"
    },
    "./logger": {
      "import": "./dist/esm/logger.js",
      "require": "./dist/cjs/logger.cjs"
    },
    ".loader/json": {
      "import": "./dist/esm/loader/json.js",
      "require": "./dist/cjs/loader/json.cjs"
    },
    ".loader/peggy": {
      "import": "./dist/esm/loader/peggy.js",
      "require": "./dist/cjs/loader/peggy.cjs"
    },
    ".loader/pem": {
      "import": "./dist/esm/loader/pem.js",
      "require": "./dist/cjs/loader/pem.cjs"
    },
    "./copy-assets": {
      "import": "./dist/esm/bin/copy-assets.js",
      "require": "./dist/cjs/bin/copy-assets.cjs"
    },
    "./make-dirs": {
      "import": "./dist/esm/bin/make-dirs.js",
      "require": "./dist/cjs/bin/make-dirs.cjs"
    },
    "./make-manifest": {
      "import": "./dist/esm/bin/make-manifest.js",
      "require": "./dist/cjs/bin/make-manifest.cjs"
    },
    "./make-version": {
      "import": "./dist/esm/bin/version.js",
      "require": "./dist/cjs/bin/version.cjs"
    }
  },
  "author": {
    "name": "Emiliano Heyns",
    "email": "Emiliano.Heyns@iris-advies.com"
  },
  "scripts": {
    "preversion": "npm test",
    "postversion": "git push --follow-tags",
    "test": "dprint fmt *.ts */*.ts && dprint check *.ts */*.ts && npm run build",
    "prebuild": "rm -rf dist",
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "start": "concurrently --raw --group 'npm run check' 'npm run build'",
    "pack": "npm test && npm pack",
    "prepublishOnly": "npm install && npm run build",
    "ncu": "ncu -u && npm i && git add package.json package-lock.json && git commit -m ncu"
  },
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@fluent/syntax": "^0.19.0",
    "@napi-rs/keyring": "^2.1.0",
    "@octokit/rest": "^22.0.1",
    "@types/node": "^26.6.5",
    "archiver": "^8.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "ini": "^7.0.0",
    "jose": "^6.2.12",
    "moment": "^2.31.0",
    "node-stream-zip": "^1.16.0",
    "peggy": "^5.1.0",
    "prompts": "^2.4.2",
    "pug": "^3.0.4",
    "rimraf": "^6.1.3",
    "url-template": "^3.1.1",
    "zotero-types": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retorquere/zotero-plugin.git"
  },
  "license": "ISC",
  "files": [
    "package.json",
    "README.md",
    "dist"
  ],
  "bin": {
    "zp-release": "dist/cjs/bin/release.cjs",
    "zp-zipup": "dist/cjs/bin/zipup.cjs",
    "zp-link": "dist/cjs/bin/link.cjs",
    "issue-branches": "dist/cjs/bin/branches.cjs",
    "zotero-start": "dist/cjs/bin/start.cjs",
    "zp-fetch-log": "dist/cjs/bin/fetch-log.cjs",
    "zp-keypair": "dist/cjs/bin/keypair.cjs",
    "zp-copy-assets": "dist/cjs/copy-assets.cjs",
    "zp-make-dirs": "dist/cjs/make-dirs.cjs",
    "zp-manifest": "dist/cjs/make-manifest.cjs",
    "zp-version": "dist/cjs/version.cjs"
  },
  "bugs": {
    "url": "https://github.com/retorquere/zotero-plugin/issues"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/ini": "^4.1.1",
    "@types/prompts": "^2.4.9",
    "concurrently": "^10.0.6",
    "dprint": "^0.61.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "dprint@0.61.1": true
  }
}
